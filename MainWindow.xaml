<Window x:Class="TSL.HMI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TSL Machine Control" Width="1440" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#141B22"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="TSL" FontSize="30" FontWeight="Bold" Margin="18,20,18,0"/><TextBlock Text="MACHINE CONTROL" Foreground="{StaticResource Muted}" Margin="19,0,18,20"/><Button Style="{StaticResource NavButton}" Content="⌂  Overview" Click="Overview_Click"/><Button Style="{StaticResource NavButton}" Content="▣  Former" Click="Former_Click"/><Button Style="{StaticResource NavButton}" Content="♨  Heat" Click="Heat_Click"/><Button Style="{StaticResource NavButton}" Content="▤  Trim" Click="Trim_Click"/><Button Style="{StaticResource NavButton}" Content="◇  Safety" Click="Safety_Click"/><Button Style="{StaticResource NavButton}" Content="≡  Recipes"/><Button Style="{StaticResource NavButton}" Content="⌕  Diagnostics" Click="Diagnostics_Click"/><Button Style="{StaticResource NavButton}" Content="⚙  Engineering"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="18"><TextBlock x:Name="MachineText" FontWeight="SemiBold"/><TextBlock x:Name="ModeText" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions><Border Background="{StaticResource Panel}" Padding="20,0"><Grid><TextBlock x:Name="PageTitle" Text="Overview" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="11" Height="11" Fill="{StaticResource Warn}" Margin="0,0,8,0"/><TextBlock Text="VALIDATION MODE" FontWeight="SemiBold"/></StackPanel></Grid></Border><ContentControl x:Name="PageHost" Grid.Row="1"/><Border Grid.Row="2" Background="#0B0F13" Padding="12,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/></Border></Grid></Grid></Window>