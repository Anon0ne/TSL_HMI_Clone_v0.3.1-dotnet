<UserControl x:Class="TSL.HMI.Views.SafetyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Safety Circuit Overview" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Door, guard, E-stop, lock-pin and lock-block points recovered from the original TSL diagnostics definition." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border><DataGrid x:Name="Grid" Grid.Row="1" Margin="6" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" RowBackground="#19212A" AlternatingRowBackground="#222D38" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Controller" Binding="{Binding Controller}" Width="140"/><DataGridTextColumn Header="Point" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="100"/><DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="90"/></DataGrid.Columns></DataGrid></Grid></UserControl>