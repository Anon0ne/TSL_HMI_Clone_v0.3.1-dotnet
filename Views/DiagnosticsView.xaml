<UserControl x:Class="TSL.HMI.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="Search" Margin="6" Height="38" VerticalContentAlignment="Center" TextChanged="Search_Changed" ToolTip="Search description, variable, controller or section"/><DataGrid x:Name="Grid" Grid.Row="1" Margin="6" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"><DataGrid.Columns><DataGridTextColumn Header="Controller" Binding="{Binding Controller}" Width="120"/><DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="150"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="240"/><DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="90"/></DataGrid.Columns></DataGrid></Grid></UserControl>